{
  "name": "cruise-quality-lab",
  "version": "1.0.0",
  "description": "Cruise booking demo with a layered, AI-assisted quality engineering pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api tests/contract",
    "test:fast": "jest --json --outputFile=results/jest.json",
    "test:e2e": "playwright test",
    "ai:testgen": "node tools/ai-testgen.js",
    "ai:select": "node tools/risk-select.js",
    "ai:triage": "node tools/triage.js",
    "gate": "node tools/gate.js",
    "demo": "bash run_pipeline.sh"
  },
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/{unit,api,contract}/**/*.test.js"
    ]
  }
}
